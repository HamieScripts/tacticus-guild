{
  "name": "tacticus-guild",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node ./scripts/build-site.js",
    "preview": "http-server dist/site -a 127.0.0.1 -p 4173 -c-1",
    "test:browser": "playwright test",
    "map:portraits": "node ./src/auto-map-portraits.js",
    "copy:portraits": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy-portraits.ps1",
    "generate:datasets": "node ./scripts/generate-dataset-manifest.js",
    "generate:players": "node ./scripts/generate-player-directory.js",
    "raid:key": "node ./scripts/set-guild-raid-key.js",
    "supabase:keys": "node ./scripts/set-supabase-keys.js",
    "db:import": "node ./scripts/import-to-supabase.js",
    "db:import:war": "node ./scripts/import-war-archives.js",
    "fetch:raid": "node ./scripts/fetch-guild-raid.js",
    "fetch:raid:range": "node ./scripts/fetch-guild-raid-range.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "http-server": "^14.1.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.2"
  }
}
